{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witness-euca-in",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The witness's endpoints go to the Worker; the rest is the verification site.
    "run_worker_first": ["/add-checkpoint", "/witness.vkey", "/status.json"]
  },
  // The witness's state: the last checkpoint cosigned for each log, and its key
  // when no WITNESS_KEY secret is set.
  "durable_objects": {
    "bindings": [{ "name": "WITNESS", "class_name": "WitnessState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WitnessState"] }],
  "routes": [{ "pattern": "witness.euca.in", "custom_domain": true }],
  "vars": {
    // The name in the witness's key and in its cosignature lines.
    "WITNESS_NAME": "witness.euca.in"
  },
  "observability": { "enabled": true }
}
