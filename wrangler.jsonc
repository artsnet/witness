{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Change name, routes, WITNESS_NAME and SITE_ORIGIN to your own before the
  // first deploy (see README.md, "Running your own witness").
  "name": "witness",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The witness's endpoints go to the Worker; the rest is the verification site.
    "run_worker_first": ["/add-checkpoint", "/witness.vkey", "/status.json", "/results", "/results.json"]
  },
  // The witness's state: per log, the last checkpoint cosigned and the auditors'
  // statements; and its key when no WITNESS_KEY secret is set.
  "durable_objects": {
    "bindings": [{ "name": "WITNESS", "class_name": "WitnessState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WitnessState"] }],
  "routes": [{ "pattern": "witness.example.org", "custom_domain": true }],
  "vars": {
    // The name in the witness's key and in its cosignature lines.
    "WITNESS_NAME": "witness.example.org",
    // Where the site is: what an auditor's passkey signature names. Set it
    // when the address the Worker sees is not the one in the browser's bar.
    "SITE_ORIGIN": "https://witness.example.org"
  },
  "observability": { "enabled": true }
}
